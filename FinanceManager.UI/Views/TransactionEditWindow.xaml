<Window x:Class="FinanceManager.UI.Views.TransactionEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transaction" Height="340" Width="480" WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical" Grid.Row="0">
            <TextBlock Text="Account" />
            <ComboBox x:Name="CmbAccount" DisplayMemberPath="Name" />
        </StackPanel>

        <StackPanel Orientation="Vertical" Grid.Row="1" Margin="0,8,0,0">
            <TextBlock Text="Category" />
            <ComboBox x:Name="CmbCategory" DisplayMemberPath="Name" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,8,0,0">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Amount" />
                <TextBox x:Name="TxtAmount" Width="160" />
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="12,0,0,0">
                <TextBlock Text="Date" />
                <StackPanel Orientation="Horizontal">
                    <DatePicker x:Name="DatePicker" />
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                        <TextBox x:Name="TxtHour" Width="40" VerticalContentAlignment="Center" MaxLength="2" ToolTip="Hour (0-23)" />
                        <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0" />
                        <TextBox x:Name="TxtMinute" Width="40" VerticalContentAlignment="Center" MaxLength="2" ToolTip="Minute (0-59)" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Vertical" Grid.Row="3" Margin="0,8,0,0">
            <TextBlock Text="Description" />
            <TextBox x:Name="TxtDescription" AcceptsReturn="True" Height="80" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="4" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnOk" Content="OK" Width="80" Margin="4" />
            <Button x:Name="BtnCancel" Content="Cancel" Width="80" Margin="4" />
        </StackPanel>
    </Grid>
</Window>
