<Window x:Class="FinanceManager.UI.Views.CategoryEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Category" Height="220" Width="400" WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical" Grid.Row="0">
            <TextBlock Text="Name" />
            <TextBox x:Name="TxtName" />
        </StackPanel>

        <StackPanel Orientation="Vertical" Grid.Row="1" Margin="0,8,0,0">
            <TextBlock Text="Type" />
            <ComboBox x:Name="CmbType" />
        </StackPanel>

        <StackPanel Orientation="Vertical" Grid.Row="2" Margin="0,8,0,0">
            <TextBlock Text="Color (hex)" />
            <TextBox x:Name="TxtColor" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="4" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnOk" Content="OK" Width="80" Margin="4" />
            <Button x:Name="BtnCancel" Content="Cancel" Width="80" Margin="4" />
        </StackPanel>
    </Grid>
</Window>
