<UserControl x:Class="FinanceManager.UI.Views.AnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FinanceManager.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Background="#071026" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical" Grid.Row="0">
            <TextBlock Text="Analytics" Foreground="#e6f0fb" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="Welcome back! Here's your financial overview for the current month" Foreground="#94a3b8" Margin="0,4,0,12" />
        </StackPanel>

        <!-- summary cards -->
        <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,12">
            <Border Background="#0f2330" CornerRadius="6" Padding="8" Margin="6">
                <StackPanel>
                    <TextBlock Text="Net Balance" Foreground="#94a3b8" FontSize="12" />
                    <TextBlock Text="{Binding Summary.NetBalance, StringFormat=C}" Foreground="#e6f0fb" FontWeight="Bold" FontSize="16" />
                </StackPanel>
            </Border>
            <Border Background="#0f2330" CornerRadius="6" Padding="8" Margin="6">
                <StackPanel>
                    <TextBlock Text="Total Income" Foreground="#94a3b8" FontSize="12" />
                    <TextBlock Text="{Binding Summary.TotalIncome, StringFormat=C}" Foreground="#3be07a" FontWeight="Bold" FontSize="16" />
                </StackPanel>
            </Border>
            <Border Background="#0f2330" CornerRadius="6" Padding="8" Margin="6">
                <StackPanel>
                    <TextBlock Text="Total Expense" Foreground="#94a3b8" FontSize="12" />
                    <TextBlock Text="{Binding Summary.TotalExpense, StringFormat=C}" Foreground="#ff6b6b" FontWeight="Bold" FontSize="16" />
                </StackPanel>
            </Border>
            <Border Background="#0f2330" CornerRadius="6" Padding="8" Margin="6">
                <StackPanel>
                    <TextBlock Text="Saving Rate" Foreground="#94a3b8" FontSize="12" />
                    <TextBlock Text="{Binding Summary.SavingRatePercent, StringFormat={}{0}%}" Foreground="#e6f0fb" FontWeight="Bold" FontSize="16" />
                </StackPanel>
            </Border>
            <Border Background="#0f2330" CornerRadius="6" Padding="8" Margin="6">
                <StackPanel>
                    <TextBlock Text="Top Income Source" Foreground="#94a3b8" FontSize="12" />
                    <TextBlock Text="{Binding Summary.TopIncomeSource}" Foreground="#3be07a" FontWeight="Bold" FontSize="16" />
                    <TextBlock Text="{Binding Summary.TopIncomeAmount, StringFormat=C}" Foreground="#3be07a" FontWeight="SemiBold" FontSize="12" />
                </StackPanel>
            </Border>
            <Border Background="#0f2330" CornerRadius="6" Padding="8" Margin="6">
                <StackPanel>
                    <TextBlock Text="Largest Expense Category" Foreground="#94a3b8" FontSize="12" />
                    <TextBlock Text="{Binding Summary.LargestExpenseCategory}" Foreground="#ff6b6b" FontWeight="Bold" FontSize="16" />
                    <TextBlock Text="{Binding Summary.LargestExpenseAmount, StringFormat=C}" Foreground="#ff6b6b" FontWeight="SemiBold" FontSize="12" />
                </StackPanel>
            </Border>
        </UniformGrid>

    <!-- charts area -->
    <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0b1626" CornerRadius="6" Padding="10" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Income by Category" Foreground="#94a3b8" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Incomes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
                                    <TextBlock Text="{Binding Name}" Width="110" Foreground="#b7c6d8" />
                                    <ProgressBar Value="{Binding Amount}" Maximum="{Binding DataContext.Summary.TotalIncome, RelativeSource={RelativeSource AncestorType=UserControl}}" Height="12" Width="200" />
                                    <TextBlock Text="{Binding Amount, StringFormat=C}" HorizontalAlignment="Right" Margin="8,0,0,0" Foreground="#94a3b8" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="#0b1626" CornerRadius="6" Padding="10" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Expenses by Category" Foreground="#94a3b8" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Expenses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
                                    <TextBlock Text="{Binding Name}" Width="110" Foreground="#b7c6d8" />
                                    <ProgressBar Value="{Binding Amount}" Maximum="{Binding DataContext.Summary.TotalExpense, RelativeSource={RelativeSource AncestorType=UserControl}}" Height="12" Width="200" Foreground="#ff6b6b" />
                                    <TextBlock Text="{Binding Amount, StringFormat=C}" HorizontalAlignment="Right" Margin="8,0,0,0" Foreground="#94a3b8" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="#0b1626" CornerRadius="6" Padding="10">
                <StackPanel>
                    <TextBlock Text="Savings Goals Progress" Foreground="#94a3b8" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Goals}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
                                    <TextBlock Text="{Binding Name}" Width="110" Foreground="#b7c6d8" />
                                    <ProgressBar Value="{Binding Percent}" Maximum="100" Height="12" Width="200" />
                                    <TextBlock Text="{Binding CurrentAmount, StringFormat=C}" HorizontalAlignment="Right" Margin="8,0,0,0" Foreground="#94a3b8" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
