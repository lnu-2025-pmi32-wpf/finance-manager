<Window x:Class="FinanceManager.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Finance Manager" Height="720" Width="1200">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
    <StackPanel Grid.Column="0" Background="{StaticResource SidebarBrush}" Margin="12">
            <TextBlock Text="Finance Manager" Foreground="White" FontSize="16" Margin="6" />
            <Button Content="Dashboard" Style="{StaticResource SidebarButton}" Click="NavDashboard_Click" />
            <Button Content="Accounts" Style="{StaticResource SidebarButton}" Click="NavAccounts_Click" />
            <Button Content="Categories" Style="{StaticResource SidebarButton}" Click="NavCategories_Click" />
            <Button Content="Transactions" Style="{StaticResource SidebarButton}" Click="NavTransactions_Click" />
            <Button Content="Profiles" Style="{StaticResource SidebarButton}" Click="NavProfiles_Click" />
            <Button Content="Analytics" Style="{StaticResource SidebarButton}" Click="NavAnalytics_Click" />
        </StackPanel>

        <!-- Content area -->
        <ContentControl x:Name="ContentArea" Grid.Column="1" />
    </Grid>
</Window>
